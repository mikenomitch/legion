{
  "title": "Campaign Overview (all systems)",
  "uid": "campaign-overview",
  "tags": ["benchmark"],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Legion: placements applied/s",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(legion_plan_apply_total{outcome=\"applied\"}[1m]))",
          "legendFormat": "legion",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Nomad: plan applies/s (nearest-equivalent)",
      "description": "nomad.nomad.plan.* family; the analysis notebook maps phase families across systems — this panel is the live sanity check, not the result.",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(nomad_nomad_plan_apply_count[1m]))",
          "legendFormat": "nomad",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "K8s: scheduler binding p99 (nearest-equivalent)",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (extension_point, le) (rate(scheduler_framework_extension_point_duration_seconds_bucket[1m])))",
          "legendFormat": "{{extension_point}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Control-plane CPU (whoever is running)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 4 }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (instance_name) (rate(node_cpu_seconds_total{mode!=\"idle\", role=\"control-plane\"}[1m]))",
          "legendFormat": "{{instance_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Sim-worker instance CPU (fleet health)",
      "description": "Sim fleets must never be the bottleneck; if these approach saturation, add instances, not excuses.",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 8 }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (instance_name) (rate(node_cpu_seconds_total{mode!=\"idle\", role=\"sim-worker\"}[1m]))",
          "legendFormat": "{{instance_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Sim fleet: nodes registered vs target",
      "description": "A gap below target with a flat error rate is a ramp still climbing; a gap with a rising one is a ramp that is stuck. Legion campaigns only — Nomad and K8s fleets are not scraped here.",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(legion_worker_simulated_nodes)",
          "legendFormat": "registered",
          "refId": "A"
        },
        {
          "expr": "sum(legion_worker_simulated_nodes_target)",
          "legendFormat": "target",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Sim fleet: heartbeat and registration rates",
      "description": "Fleet-wide, summed over every sim host. Failed heartbeats or a nonzero registration-error rate mean the fleet is fighting the manager rather than loading it.",
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(legion_worker_heartbeats_total{outcome=\"ok\"}[1m]))",
          "legendFormat": "heartbeats ok",
          "refId": "A"
        },
        {
          "expr": "sum(rate(legion_worker_heartbeats_total{outcome!=\"ok\"}[1m]))",
          "legendFormat": "heartbeats failed",
          "refId": "B"
        },
        {
          "expr": "sum(rate(legion_worker_simulated_registrations_total{outcome=\"error\"}[1m]))",
          "legendFormat": "registration errors",
          "refId": "C"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Sim fleet: heartbeat round-trip p99",
      "description": "The workers' own view of manager pressure, and the counterpart to the manager's plan-phase histogram: a p99 that climbs with node count is what a scale claim has to explain.",
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(legion_worker_heartbeat_duration_seconds_bucket[1m])))",
          "legendFormat": "p99",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(legion_worker_heartbeat_duration_seconds_bucket[1m])))",
          "legendFormat": "p50",
          "refId": "B"
        }
      ]
    }
  ]
}
