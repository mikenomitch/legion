# Pinned versions for everything the campaign installs. Every value here
# lands in the fairness record (collect.sh) — bump deliberately, never
# mid-campaign.
#
# Refreshed 2026-10-09 for the cross-system campaign. The comparison has
# to be against releases a reader would run today: Nomad 1.8 left support
# on 2026-04-30, and a K8s 1.31 number would be dismissed as stale.
NOMAD_VERSION="2.0.5"
# nomad-nodesim main @ "build: Update Nomad to v2.0.5" (2026-09-04), so the
# simulated clients speak the same Nomad version as the servers.
NOMAD_NODESIM_REF="702a0d9b1d53aee8be751594cc7d9e1d15aa84b1"
# nodesim's go.mod asks for Go 1.26.5; Ubuntu's golang-go is far older.
GO_VERSION="1.26.9"
# The newest K8s that KWOK v0.8.0 publishes cluster images for (1.36.1);
# 1.36.5 is that minor's latest patch on pkgs.k8s.io. 1.37 exists but KWOK
# has not been released against it yet.
K8S_VERSION="1.36.5"
KWOK_VERSION="0.8.0"
NODE_EXPORTER_VERSION="1.8.2" # informational; installed by cloud-init
