# Loadgen Prometheus config. Rendered by scripts/install-loadgen.sh with
# envsubst: CP0_IP, CP1_IP, CP2_IP. Node-exporter and sim-worker targets
# are file-based (targets/*.json), regenerated by scripts/gen-targets.sh
# whenever the spot fleet changes — a scrape config edit must never
# require a Prometheus restart mid-campaign.
global:
  scrape_interval: 5s
  evaluation_interval: 5s

scrape_configs:
  # Legion managers: /metrics on the telemetry port. The scheduler
  # phase histogram here is the campaign's core measurement.
  - job_name: legion-managers
    static_configs:
      - targets:
          - "${CP0_IP}:4749"
          - "${CP1_IP}:4749"
          - "${CP2_IP}:4749"

  # CPU/mem per box — control-plane cost is a first-class result.
  - job_name: node
    file_sd_configs:
      - files: ["/etc/prometheus/targets/node-*.json"]
        refresh_interval: 15s

  # Nomad campaign: servers publish Prometheus-format telemetry on the
  # HTTP API port (configs/nomad/server.hcl.tpl enables it).
  - job_name: nomad-servers
    metrics_path: /v1/metrics
    params:
      format: ["prometheus"]
    static_configs:
      - targets:
          - "${CP0_IP}:4646"
          - "${CP1_IP}:4646"
          - "${CP2_IP}:4646"

  # K8s campaign: kube-scheduler/apiserver metrics need HTTPS + a bearer
  # token; scripts/install-k8s.sh appends a rendered scrape job (with the
  # token it extracts) to /etc/prometheus/targets/k8s-scrape.yml and
  # reloads. Kept out of the static template so the Legion/Nomad
  # campaigns carry no dead config.
