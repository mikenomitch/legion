{
  "name": "ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lab": "vite --mode lab",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "gen": "protoc -I ../proto --plugin=protoc-gen-connect-es=./node_modules/.bin/protoc-gen-connect-es --plugin=protoc-gen-es=./node_modules/.bin/protoc-gen-es --connect-es_out=src/gen --connect-es_opt=target=ts --es_out=src/gen --es_opt=target=ts ../proto/legion.proto",
    "preview": "vite preview",
    "lab:contrast": "node scripts/lab-contrast.mjs",
    "lab:shots": "node scripts/lab-shots.mjs",
    "lab:record": "vite --mode record",
    "lab:crawl": "node scripts/lab-crawl.mjs",
    "gen:appearance": "node scripts/gen-appearance-css.mjs",
    "check:appearance": "node scripts/gen-appearance-css.mjs --check"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.1",
    "@connectrpc/connect": "^1.7.0",
    "@connectrpc/connect-web": "^1.7.0",
